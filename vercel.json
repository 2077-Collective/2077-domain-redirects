{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "etherpedia.2077.xyz" }],
      "destination": "https://etherpedia.2077collective.xyz",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://research.2077.xyz",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "etherpedia.2077.xyz"
        }
      ],
      "destination": "https://etherpedia.2077collective.xyz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://research.2077.xyz",
      "permanent": true
    }
  ]
}
